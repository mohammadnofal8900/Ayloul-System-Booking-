@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ayloul jo — 3D Rose Frame</title>
    <script src="~/assets2/js/main.js"></script>
    <link href="~/assets2/css/style.css" rel="stylesheet" />
    <script src="~/assets2/js/roseframe3d.js"></script>
    <!-- Three.js via ES module CDN. Swap these for locally-hosted files /
         your own npm build if you prefer (see README "Production notes"). -->


    <script type="importmap">
        {
          "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
          }
        }
    </script>
</head>
<body>

    <!-- ================= ordinary content above the 3D section ================= -->
    <section class="content-block">
        <h1>ayloul jo</h1>
        <p>A small keepsake, rendered in real 3D. Scroll down to turn it around.</p>
    </section>

    <!-- ================= the 3D scroll section ================= -->
    <section class="rose-section" data-rose-section>
        <div class="rose-stage" data-rose-stage>
            <canvas class="rose-canvas" data-rose-canvas aria-label="Interactive 3D rose frame — drag to rotate"></canvas>

            <div class="rose-loading" data-rose-loading hidden>
                <span class="rose-spinner"></span>
                <span>Loading 3D model…</span>

            </div>

            <div class="rose-hint" data-rose-hint>
                <span>Scroll to rotate — or drag</span>
                <a href="/assets2/models/rose.glb" target="_blank">
                    Test 3D Model
                </a>
            </div>
        </div>
    </section>

    <!-- ================= ordinary content below the 3D section ================= -->
    <section class="content-block">
        <h2>Next section</h2>
        <p>The rest of your page continues here, unaffected by the 3D section above.</p>
    </section>

    <script type="module" src="~/assets2/js/main.js"></script>
</body>
</html>
