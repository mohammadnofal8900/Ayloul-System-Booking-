@model IEnumerable<Department>



<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">View Department</h3>
            <nav aria-label="breadcrumb">

                <a class="btn btn-inverse-primary btn-fw" asp-action="AddDepartment" asp-controller="Department">Add Department</a>
            </nav>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Department_Name</td>

                                        <td>

                                            <a asp-action="EditDepartment"
                                               asp-controller="Department"
                                               asp-area="Admin"
                                               asp-route-id="@item.Department_Id"
                                               style="font-size: 0.75rem;width:50px"
                                               class="btn btn-outline-primary rounded-pill px-3 py-0">

                                                <i class="mdi mdi-pencil"></i>
                                            </a>

                                            <a asp-action="DeleteDepartment"
                                               asp-controller="Department"
                                               asp-route-id="@item.Department_Id"
                                               class="btn btn-outline-danger rounded-pill px-3 py-0"
                                               style="font-size: 0.75rem;width:50px">
                                                <i class="mdi mdi-delete"></i>
                                            </a>

                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- content-wrapper ends -->
    <!-- partial:../../partials/_footer.html -->
    
    <!-- partial -->
</div>