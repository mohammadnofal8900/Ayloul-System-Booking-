
@model Department


<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">Add Department</h3>
            <nav aria-label="breadcrumb">
                
            </nav>
        </div>
        <div class="row">
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    
                </div>
            </div>
         
            </div>
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        
                        
                        <form asp-action="AddDepartment" asp-controller="Department method="post" enctype="multipart/form-data" class="forms-sample">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="Department_Name">Department Name</label>
                                <input asp-for="Department_Name" type="text" class="form-control" id="exampleInputName1" placeholder="Department Name">
                                <span asp-validation-for="Department_Name" class="text-danger"></span>

                            </div>
                            
                           <button type="submit" class="btn btn-gradient-primary me-2">Submit</button>
                            <a class="btn btn-light" asp-area="Admin" asp-controller="Department" asp-action="ViewDepartment">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- content-wrapper ends -->
