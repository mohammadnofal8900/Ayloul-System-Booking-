@model ChatRoom

@{
    ViewData["Title"] = "Chat Room";
}

<style>

    .chat-wrapper {
        max-width: 1000px;
        margin: 30px auto;
    }

    .chat-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    /* =========================
           Header
           ========================= */

    .chat-header {
        padding: 20px 25px;
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .customer-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        border: 1px solid rgba(255,255,255,0.35);
    }

    .chat-header h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
    }

    .chat-header-name {
        margin-top: 3px;
        font-size: 13px;
        opacity: 0.9;
    }

    .online-status {
        margin-top: 3px;
        font-size: 12px;
        opacity: 0.9;
    }

    .online-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #ffffff;
        border-radius: 50%;
        margin-right: 5px;
    }

    /* =========================
           Chat Body
           ========================= */

    .chat-body {
        padding: 0;
        background: #f7f8fc;
    }

    #messages {
        height: 500px;
        overflow-y: auto;
        padding: 25px;
        border: none !important;
        background: radial-gradient( circle at top right, rgba(40,167,69,0.06), transparent 35% );
    }

        /* =========================
           Scrollbar
           ========================= */

        #messages::-webkit-scrollbar {
            width: 6px;
        }

        #messages::-webkit-scrollbar-track {
            background: transparent;
        }

        #messages::-webkit-scrollbar-thumb {
            background: #c9cdd8;
            border-radius: 10px;
        }

    /* =========================
           Message Row
           ========================= */

    .message-row {
        display: flex;
        margin-bottom: 18px;
    }

        .message-row.sent {
            justify-content: flex-end;
        }

        .message-row.received {
            justify-content: flex-start;
        }

    /* =========================
           Message Bubble
           ========================= */

    .message-bubble {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 16px;
        position: relative;
        font-size: 14px;
        line-height: 1.5;
    }

    /* Admin message */

    .message-row.sent .message-bubble {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border-bottom-right-radius: 5px;
        box-shadow: 0 4px 12px rgba(40,167,69,0.18);
    }

    /* Customer message */

    .message-row.received .message-bubble {
        background: white;
        color: #343a40;
        border: 1px solid #eceef3;
        border-bottom-left-radius: 5px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.04);
    }

    .sender-name {
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 4px;
        color: #28a745;
    }

    .message-text {
        word-break: break-word;
    }

    .message-time {
        display: block;
        font-size: 10px;
        margin-top: 6px;
        opacity: 0.65;
        text-align: right;
    }

    .message-row.sent .message-time {
        color: rgba(255,255,255,0.85);
    }

    /* =========================
           Input
           ========================= */

    .chat-input-area {
        padding: 18px 20px;
        background: white;
        border-top: 1px solid #eee;
    }

    .chat-input-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f5f6fa;
        border: 1px solid #e5e7ee;
        border-radius: 14px;
        padding: 6px;
    }

    #messageInput {
        border: none;
        background: transparent;
        box-shadow: none !important;
        outline: none !important;
        padding: 12px 14px;
        height: 48px;
    }

        #messageInput:focus {
            background: transparent;
        }

    .send-btn {
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 12px;
        background: linear-gradient( 135deg, #28a745, #20c997 );
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .send-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(40,167,69,0.3);
            color: white;
        }

        .send-btn i {
            font-size: 20px;
        }

    /* =========================
           Mobile
           ========================= */

    @@media (max-width: 768px) {

        .chat-wrapper {
            margin: 10px;
        }

        #messages {
            height: 450px;
            padding: 15px;
        }

        .message-bubble {
            max-width: 85%;
        }

        .chat-header {
            padding: 16px;
        }
    }

</style>


<div class="chat-wrapper">

    <div class="chat-card">


        <!-- =========================
             HEADER
             ========================= -->

        <div class="chat-header">

            <div class="chat-header-left">

                <div class="customer-avatar">

                    <i class="mdi mdi-account"></i>

                </div>


                <div>

                    <h4>
                        Chat With Customer
                    </h4>

                    <div class="chat-header-name">

                        @(Model.Customer != null
                                                ? Model.Customer.UserName
                                                : "Unknown Customer")

                    </div>

                    <div class="online-status">

                        <span class="online-dot"></span>

                        Customer Support

                    </div>

                </div>

            </div>


            <i class="mdi mdi-message-text-outline"
               style="font-size:26px;">
            </i>

        </div>


        <!-- =========================
             CHAT BODY
             ========================= -->

        <div class="chat-body">


            <div id="messages">


                @foreach (var item in Model.Messages.OrderBy(x => x.SentAt))
                {

                    if (item.Sender_Id ==
                    User.FindFirst(
                    System.Security.Claims.ClaimTypes.NameIdentifier
                    ).Value)
                    {

                        <!-- ADMIN MESSAGE -->

                        <div class="message-row sent">

                            <div class="message-bubble">

                                <div class="message-text">

                                    @item.Message_Text

                                </div>

                                <span class="message-time">

                                    @item.SentAt.ToString("HH:mm")

                                    <i class="mdi mdi-check-all"></i>

                                </span>

                            </div>

                        </div>

                    }
                    else
                    {

                        <!-- CUSTOMER MESSAGE -->

                        <div class="message-row received">

                            <div class="message-bubble">

                                @if (item.Sender != null)
                                {
                                    <div class="sender-name">

                                        <i class="mdi mdi-account-outline"></i>

                                        @item.Sender.UserName

                                    </div>
                                }

                                <div class="message-text">

                                    @item.Message_Text

                                </div>

                                <span class="message-time">

                                    @item.SentAt.ToString("HH:mm")

                                </span>

                            </div>

                        </div>

                    }

                }


            </div>


            <!-- =========================
                 INPUT
                 ========================= -->

            <div class="chat-input-area">

                <div class="chat-input-wrapper">

                    <input id="messageInput"
                           class="form-control"
                           placeholder="Write a message..."
                           autocomplete="off" />


                    <button onclick="sendMessage()"
                            class="send-btn"
                            type="button">

                        <i class="mdi mdi-send"></i>

                    </button>

                </div>

            </div>


        </div>

    </div>

</div>


@section Scripts
{

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>


    <script>

        const connection =
        new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();


        connection.start()
        .then(function(){

            connection.invoke(
                "JoinRoom",
                @Model.ChatRoom_Id
            );

            scrollToBottom();

        });


        connection.on(
        "ReceiveMessage",
        function(sender,message)
        {

            let box =
            document.getElementById("messages");


            box.innerHTML += `

                <div class="message-row sent">

                    <div class="message-bubble">

                        <div class="message-text">

                            ${message}

                        </div>

                        <span class="message-time">

                            ${new Date().toLocaleTimeString([], {
                                hour: '2-digit',
                                minute: '2-digit'
                            })}

                            <i class="mdi mdi-check-all"></i>

                        </span>

                    </div>

                </div>

            `;


            scrollToBottom();

        });


        function sendMessage()
        {

            let message =
            document.getElementById("messageInput").value;


            if(message.trim() == "")
                return;


            connection.invoke(

                "SendMessage",

                @Model.ChatRoom_Id,

                "@User.FindFirst(
                                    System.Security.Claims.ClaimTypes.NameIdentifier
                            )?.Value",

            message

            );


            document.getElementById("messageInput").value = "";

        }


        function scrollToBottom()
        {

            let box =
            document.getElementById("messages");

            box.scrollTop =
            box.scrollHeight;

        }


        // Enter = Send

        document
        .getElementById("messageInput")
        .addEventListener(
            "keydown",
            function(event)
            {

                if(event.key === "Enter")
                {

                    event.preventDefault();

                    sendMessage();

                }

            }
        );

    </script>

}