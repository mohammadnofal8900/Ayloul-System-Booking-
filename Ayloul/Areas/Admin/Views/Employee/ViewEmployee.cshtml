@model IEnumerable<Employee>


<div class="card">
    <div class="card-body">
        <h4 class="card-title">View Employee</h4>
        <p class="card-description">
            <a class="btn btn-inverse-primary btn-fw" asp-action="CreateEmployee" asp-controller="Employee">Add Employee</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Salary</th>
                    <th>Phone Number</th>
                    <th>Gender</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Location</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Employee_Email</td>
                        <td>@item.Employee_Salary</td>
                        <td>@item.Mobile_Phone</td>
                        <td>@item.Gender?.Gender_Name</td>
                        <td>@item.Employee_Date.ToString("dd-MMMM-yyyy")</td>
                        <td>
                            @if (item.Is_Active == true)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Not Active</span>
                            }
                        </td>
                        <td>@item.Location?.City</td>
                        <td>@item.department?.Department_Name</td>
                        <td>@ViewBag.Roles[item.UserId]</td>



                        <td>

                            <a asp-action="EditEmployee"
                               asp-controller="Employee"
                               asp-area="Admin"
                               asp-route-id="@item.UserId"
                               class="btn btn-outline-primary rounded-pill px-3 py-0"
                               style="font-size: 0.75rem;width:50px">

                                <i class="mdi mdi-pencil"></i>
                            </a>

                        </td>
                        <td>
                            <a asp-action="DeleteEmployee"
                               asp-controller="Employee"
                               asp-route-id="@item.UserId"
                               class="btn btn-outline-danger rounded-pill px-3 py-0"
                               style="font-size: 0.75rem;width:50px">
                                <i class="mdi mdi-delete"></i>
                            </a>
                        </td>


                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>