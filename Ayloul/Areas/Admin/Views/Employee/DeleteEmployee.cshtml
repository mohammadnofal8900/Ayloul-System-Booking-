@model Employee



<div class="main-panel">
    <div class="content-wrapper">

        <div class="card-header bg-danger text-white" style="margin-bottom:30px">
            <h4 class="mb-0" style="padding:40px">Delete Employee</h4>
        </div>


        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this employee?
            </h5>

            <hr />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Name</label>
                    <p>@Model.User?.FUllName</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Email</label>
                    <p>@Model.Employee_Email</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Phone</label>
                    <p>@Model.Mobile_Phone</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Salary</label>
                    <p>@Model.Employee_Salary</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Gender</label>
                    <p>@Model.Gender?.Gender_Name</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Department</label>
                    <p>@Model.department?.Department_Name</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Location</label>
                    <p>@Model.Location?.City</p>
                </div>


                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Status</label>
                    <p>
                        @(Model.Is_Active ? "Active" : "Inactive")
                    </p>
                </div>

            </div>


            <form asp-action="DeleteEmployee" method="post">

                <input type="hidden" asp-for="UserId" />


                <button type="submit" class="btn btn-danger">
                    <i class="mdi mdi-delete"></i>
                    Delete
                </button>


                <a asp-action="ViewEmployee"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

    </div>
    </div>
    <!-- content-wrapper ends -->
    <!-- partial:../../partials/_footer.html -->

    <!-- partial -->
</div>