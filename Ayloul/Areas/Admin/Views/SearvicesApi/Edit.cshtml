
@model Ayloul.Areas.Admin.Models.ServicesApiVm

<div class="main-panel">
    <div class="content-wrapper">

        <div class="page-header">
            <h3 class="page-title">Edit Service</h3>

            <nav aria-label="breadcrumb">
                <a asp-area="Admin"
                   asp-controller="SearvicesApi"
                   asp-action="Edit"
                   class="btn btn-light">
                    Back
                </a>
            </nav>
        </div>

        <div class="row">

            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                </div>
            </div>

            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                </div>
            </div>

            <div class="col-12 grid-margin stretch-card">
                <div class="card">

                    <div class="card-body">

                        <form asp-area="Admin"
                              asp-controller="SearvicesApi"
                              asp-action="Edit"
                              method="post"
                              enctype="multipart/form-data"
                              class="forms-sample">

                            @Html.AntiForgeryToken()

                            <!-- Service ID -->
                            <input type="hidden" asp-for="Service_Id" />
                            <input type="hidden" asp-for="img" />


                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger">
                            </div>


                            <!-- Service Name -->
                            <div class="form-group">
                                <label asp-for="Service_Name">
                                    Service Name
                                </label>

                                <input asp-for="Service_Name"
                                       type="text"
                                       class="form-control"
                                       placeholder="Enter Service Name" />

                                <span asp-validation-for="Service_Name"
                                      class="text-danger">
                                </span>
                            </div>


                            <!-- Price -->
                            <div class="form-group">
                                <label asp-for="Price">
                                    Price
                                </label>

                                <input asp-for="Price"
                                       type="number"
                                       class="form-control"
                                       placeholder="Price" />

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>
                            </div>


                            <!-- Status -->
                            <div class="form-group">
                                <label asp-for="Is_Active">
                                    Status
                                </label>

                                <select asp-for="Is_Active"
                                        class="form-control">

                                    <option value="true">
                                        Active
                                    </option>

                                    <option value="false">
                                        Not Active
                                    </option>

                                </select>
                            </div>


                            @* <!-- Current Image -->
                            @if (!string.IsNullOrEmpty(Model.Image_Path))
                            {
                                <div class="form-group">
                                    <label>
                                        Current Image
                                    </label>

                                    <div>
                                        <img src="@Model.Image_Path"
                                             alt="Service Image"
                                             style="width: 150px; height: 150px; object-fit: cover; border-radius: 10px;" />
                                    </div>
                                </div>
                            } *@


                            <!-- New Image -->
                            <div class="form-group">

                                <label asp-for="ImageFile">
                                    Change Image
                                </label>

                                <input asp-for="ImageFile"
                                       type="file"
                                       class="form-control"
                                       accept="image/*" />

                                <span asp-validation-for="ImageFile"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Buttons -->
                            <button type="submit"
                                    class="btn btn-gradient-primary me-2">
                                Save Changes
                            </button>

                            <a asp-area="Admin"
                               asp-controller="SearvicesApi"
                               asp-action="Index"
                               class="btn btn-light">
                                Cancel
                            </a>

                        </form>

                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- Footer -->
    

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
