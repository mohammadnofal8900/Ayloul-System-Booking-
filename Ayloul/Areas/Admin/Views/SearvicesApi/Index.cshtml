
@model IEnumerable<ServicesApiVm>

<div class="main-panel">
    <div class="content-wrapper">

        <!-- Page Header -->
        <div class="page-header">
            <h3 class="page-title">Services</h3>

            <nav aria-label="breadcrumb">
                <a class="btn btn-inverse-primary btn-fw"
                   asp-action="Create"
                   asp-controller="SearvicesApi"
                   asp-area="Admin">
                    Add Service
                </a>
            </nav>
        </div>

        <!-- Error Message -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong>
                @ViewBag.ErrorMessage

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">

                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Services List</h4>

                        @if (Model == null || !Model.Any())
                        {
                            <div class="alert alert-info text-center">
                                <h5>No Services Available</h5>
                                <p class="mb-0">
                                    There are currently no services available.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table">

                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                            <th>Image</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                
                                                <!-- Name -->
                                                <td>
                                                    @item.Service_Name
                                                </td>

                                                <!-- Price -->
                                                <td>
                                                    @item.Price JD
                                                </td>

                                                <!-- Status -->
                                                <td>
                                                    @if (item.Is_Active)
                                                    {
                                                        <span class="badge badge-success">
                                                            Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">
                                                            Not Active
                                                        </span>
                                                    }
                                                </td>

                                                <!-- Image -->
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.img))
                                                    {
                                                        <img src="~/Images/Service/@item.img"
                                                             width="100"
                                                             height="100"
                                                             style="object-fit:cover;width:150px;height:150px"
                                                             asp-append-version="true" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>

                                                <!-- Actions -->
                                                <td>

                                                    <!-- Edit -->
                                                    <a asp-action="Edit"
                                                       asp-controller="SearvicesApi"
                                                       asp-area="Admin"
                                                       asp-route-id="@item.Service_Id"
                                                       class="btn btn-outline-warning btn-fw">
                                                        <i class="mdi mdi-pencil"></i>
                                                        Edit
                                                    </a>

                                                    <!-- Delete -->
                                                    <form asp-area="Admin"
                                                          asp-controller="SearvicesApi"
                                                          asp-action="Delete"
                                                          asp-route-id="@item.Service_Id"
                                                          method="post"
                                                          style="display:inline;"
                                                          onsubmit="return confirm('Are you sure you want to delete this service?');">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-fw">
                                                            <i class="mdi mdi-delete"></i>
                                                            Delete
                                                        </button>

                                                    </form>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Footer -->


</div>

