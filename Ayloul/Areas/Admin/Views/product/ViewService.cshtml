@model IEnumerable<Service>

                          
                            

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">Service</h3>
            <nav aria-label="breadcrumb">

                <a class="btn btn-inverse-primary btn-fw" asp-action="AddService" asp-controller="Product">Add Frame Color</a>
            </nav>
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Img</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Service_Name</td>
                                        <td>@item.Price JD</td>
                                        <td>
                                            @if (item.Is_Active == true)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Not Active</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.img))
                                            {
                                                <img src="~/Images/Service/@item.img"
                                                     width="100"
                                                     height="100"
                                                     style="object-fit:cover;"
                                                     asp-append-version="true" />
                                            }
                                            else
                                            {
                                                <span>No Image</span>
                                            }
                                        </td>

                                        <td>

                                            <a asp-action="EditService"
                                               asp-controller="Product"
                                               asp-area="Admin"
                                               asp-route-id="@item.Service_Id"
                                               class="btn btn-outline-warning btn-fw">
                                                <i class="mdi mdi-pencil">Edit</i>
                                            </a>

                                            <a asp-action="DeleteService"
                                               asp-controller="Product"
                                               asp-area="Admin"
                                               asp-route-id="@item.Service_Id"
                                               class=" btn btn-outline-danger btn-fw">
                                                <i class="mdi mdi-delete">Delete</i>
                                            </a>

                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- content-wrapper ends -->
    <!-- partial:../../partials/_footer.html -->
    <footer class="footer">
        <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright © 2023 . All rights reserved. Distributed by <a href="#">Ayloul</a></span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">Hand-crafted &amp; made with <i class="mdi mdi-heart text-danger"></i></span>
        </div>
    </footer>
    <!-- partial -->
</div>