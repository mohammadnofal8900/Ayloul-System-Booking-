<div class="card">
    <div class="card-body">
        <h4 class="card-title">View Booking</h4>
        <p class="card-description">



         
        </div>
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Booking Number</th>
                                    <th>Date Time</th>
                                    <th>Order Date</th>
                                    <th>User Name</th>
                                    <th>Phone Number</th>
                                    <th>Total Price</th>
                                    <th>Order Status</th>
                                    <th>Payment</th>
                                    <th>Action</th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            <span class="fw-bold">
                                                #@item.Booking_Number
                                            </span>
                                        </td>


                                        <td>
                                            @item.Date_Time.ToString("dd MMM yyyy hh:mm tt")
                                        </td>


                                        <td>
                                            @item.Order_Date.ToString("dd MMM yyyy")
                                        </td>


                                        <td>
                                            <div class="d-flex justify-content-center align-items-center">

                                                <span class="user-icon">
                                                    🌹
                                                </span>

                                                @(item.Customer?.User?.UserName ?? "-")

                                            </div>
                                        </td>


                                        <td>
                                            <span class="text-muted">
                                                📞 @item.Phone_Number
                                            </span>
                                        </td>


                                        <td>
                                            <span class="price">
                                                @item.TotalPrice $
                                            </span>
                                        </td>


                                        <td>

                                            @if (item.Is_Active)
                                            {
                                                <span class="badge rounded-pill bg-success px-3">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary px-3">
                                                    Pending
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            @if (item.paymentMethod == 0)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">
                                                    💵 Cash
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info rounded-pill">
                                                    💳 Visa @* @item.paymentMethod *@
                                                </span>
                                            }

                                        </td>



                                        <td>

                                            <a asp-action="ViewInfoBooking"
                                               asp-controller="Booking"
                                               asp-area="Admin"
                                               asp-route-id="@item.Booking_Id"
                                               class="btn btn-outline-primary rounded-pill px-3 py-0"
                                               style="font-size: 0.75rem;width:50px">
                                                <i class="mdi mdi-eye"></i> 
                                            </a>

                                            <a asp-action="DeleteBooking"
                                               asp-controller="Booking"
                                               asp-route-id="@item.Booking_Id"
                                               class="btn btn-outline-danger rounded-pill px-3 py-0"
                                               style="font-size: 0.75rem;width:50px">
                                                <i class="mdi mdi-delete"></i> 
                                            </a>

                                        </td>


                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- content-wrapper ends -->
