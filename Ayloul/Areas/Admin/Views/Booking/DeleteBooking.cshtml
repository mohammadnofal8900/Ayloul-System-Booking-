@model Booking

<div class="card">
    

    <div class="card-body">

        <form asp-action="DeleteBooking" asp-controller="Booking" asp-area="Admin" method="post" enctype="multipart/form-data">
            <h3 class="text text-danger" >Are you sure you need delete this booking ??</h3>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div><input type="hidden" asp-for="Booking_Id" /></div>

            <div class="row">


                <div class="col-md-6 mb-3">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" readonly class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone_Number"></label>
                    <input asp-for="Phone_Number" readonly class="form-control" />
                    <span asp-validation-for="Phone_Number" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Date_Time"></label>
                    <input asp-for="Date_Time" readonly type="datetime-local" class="form-control" />
                    <span asp-validation-for="Date_Time" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" readonly class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Note"></label>
                    <textarea asp-for="Note" readonly class="form-control"></textarea>
                </div>
               
                <div class="col-md-6 mb-3">
                    <label asp-for="Event_Date"></label>
                    <input readonly asp-for="Event_Date" class="form-control" />
                </div>

                


            </div>

            <button type="submit" class="btn btn-success">
                Delete
            </button>



        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}