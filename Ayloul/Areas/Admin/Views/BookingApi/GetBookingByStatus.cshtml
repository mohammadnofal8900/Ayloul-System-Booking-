<div class="card">
    <div class="card-body">
        <h4 class="card-title">View Booking</h4>
        <p class="card-description">




    </div>
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Booking Number</th>
                                <th>Date Time</th>
                                <th>Order Date</th>
                                <th>User Name</th>
                                <th>Phone Number</th>
                                <th>Total Price</th>
                                <th>Order Status</th>
                                <th>Payment</th>
                                <th>Action</th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    

                                    <td>
                                        <span class="fw-bold">
                                            #@item.BookingNumber
                                        </span>
                                    </td>


                                    <td>
                                        @item.DateTime.ToString("dd MMM yyyy hh:mm tt")
                                    </td>


                                    <td>
                                        @item.OrderDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        <div class="d-flex justify-content-center align-items-center">

                                            <span class="user-icon">
                                                🌹
                                            </span>

                                            @(item.FullName)

                                        </div>
                                    </td>


                                    <td>
                                        <span class="text-muted">
                                            📞 @item.PhoneNumber
                                        </span>
                                    </td>


                                    <td>
                                        <span class="price">
                                            @item.TotalPrice $
                                        </span>
                                    </td>


                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success px-3">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary px-3">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.PaymentMethod == 0 || item.PaymentMethod==null)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill">
                                                💵 Cash
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info rounded-pill">
                                                💳 Visa @* @item.paymentMethod *@
                                            </span>
                                        }

                                    </td>



                                    <td>

                                        <a asp-action="ViewInfoBooking"
                                           asp-controller="BookingApi"
                                           asp-area="Admin"
                                           asp-route-id="@item.Booking_Id"
                                           class="btn btn-outline-primary rounded-pill px-3 py-0"
                                           style="font-size: 0.75rem;width:50px">
                                            <i class="mdi mdi-eye"></i>
                                        </a>

                                        <form asp-action="DeleteBooking"
                                              asp-controller="BookingApi"
                                              asp-area="Admin"
                                              asp-route-id="@item.Booking_Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this Booking?');">




                                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-0"
                                                    style="font-size: 0.75rem;width:50px;margin-top:10px">
                                                <i class="mdi mdi-delete"></i>
                                            </button>

                                        </form>

                                    </td>


                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- content-wrapper ends -->
