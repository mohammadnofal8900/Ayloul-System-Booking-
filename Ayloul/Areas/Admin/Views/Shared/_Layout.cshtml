@using Microsoft.Extensions.Localization;
@inject IStringLocalizer<SharedResource> Localizer;

@{
    var culter = System.Threading.Thread.CurrentThread.CurrentCulture;
}

<!DOCTYPE html>
<html lang="@culter.TwoLetterISOLanguageName"
 dir="@(culter.TextInfo.IsRightToLeft ?"rtl":"ltr")">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Purple Admin</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/assets/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/assets/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/assets/css/style.css">
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/assets/images/favicon.png">
</head>
<body>
    <div class="container-scroller">
        <!-- partial:~/partials/_navbar.html -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <a class="navbar-brand brand-logo" asp-action="FinancialReport" asp-area="Admin" asp-controller="Reports">
                    
                    <img class="brand-logo" style="width:70px;height:70px;" src="~/images/AyloulLogo/LogoAyloul.webp" />
                </a>
                
                <a class="navbar-brand brand-logo-mini" asp-action="FinancialReport" asp-area="Admin" asp-controller="Reports"><img src="~/assets/images/logo-mini.svg" alt="logo"></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>
                <div class="search-field d-none d-md-block">
                    <div class="search-field d-none d-md-block">
                        <div class="d-flex align-items-center h-100">
                            <div class="input-group">
                                <div class="input-group-prepend bg-transparent">
                                    <i class="input-group-text border-0 mdi mdi-magnify"></i>
                                </div>

                                <input type="text"
                                       id="pageSearch"
                                       class="form-control bg-transparent border-0"
                                       placeholder="Search..." />
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="navbar-nav navbar-nav-right">


                    <li class="nav-item nav-profile dropdown">
                         @if (User.Identity.IsAuthenticated)
    {
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-profile-img">
                                </div>
                            <div class="nav-profile-text">
                                <p class="mb-1 text-black">
                                    @User.FindFirst("FullName")?.Value
                                </p>
                            </div>

                        </a>
                        <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown">
                                <a class="dropdown-item" asp-area="User"
                                   asp-controller="Profile"
                                   asp-action="Profile">
                                    
                                <i class="mdi mdi-cached me-2 text-success"></i> Profile
                            </a>
                            <div class="dropdown-divider"></div>
                                <a class="dropdown-item"
                                   asp-area="User"
                                   asp-controller="Account"
                                   asp-action="LogOut">

                                    <i class="mdi mdi-logout me-2 text-primary"></i>
                                    Sign Out

                                </a>
                        </div>
                        }
                    </li>
                    

                    

                    <li class="nav-item d-none d-lg-block full-screen-link">
                        <a class="nav-link">
                            <i class="mdi mdi-fullscreen" id="fullscreen-button"></i>
                        </a>
                                                              @if (User.Identity.IsAuthenticated &&
   (User.IsInRole("Admin") || User.IsInRole("Super Admin")))
{
                       @*  @await Component.InvokeAsync("ChatList") *@
}
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav> 
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial:~/partials/_sidebar.html -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-action="FinancialReport" asp-area="Admin" asp-controller="Reports">
                            <span class="menu-title">@Localizer["dashboard"]</span>
                            <i class="menu-arrow"></i>
                            <i class="fa fa-home"></i>
                            
                        </a>
                    </li>

                    @{
                        bool Is_Arabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Change_Language" asp-area="" asp-controller="Language"
                           asp-route-return_url="@Context.Request.Path"
                           asp-route-culter="@(Is_Arabic ? "En" : "Ar")">
                            

                            <span class="menu-title">@(Is_Arabic ? "Ar" : "En")</span>
                            <i class="menu-arrow"></i>
                            <i class="fa-solid fa-globe"></i>

                        </a>
                    </li>
                                                          @if (User.Identity.IsAuthenticated && ( User.IsInRole("Super Admin")))
                    {
                        <li class="nav-item">
                            <a class="nav-link"  data-bs-toggle="collapse" href="#ui-basic" aria-expanded="false" aria-controls="ui-basic">
                                <span class="menu-title">@Localizer["management"]</span>
                                <i class="menu-arrow"></i>
                                <i class="fa fa-address-card"></i>
                            </a>
                            <div class="collapse" id="ui-basic">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="EmployeeView" asp-area="Admin" asp-controller="EmployeeApi">@Localizer["Employee"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewDepartment" asp-area="Admin" asp-controller="Department">@Localizer["Departments"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewRole" asp-area="Admin" asp-controller="Role">@Localizer["Role"]</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    }
                                                          @if (User.Identity.IsAuthenticated && (User.IsInRole("Super Admin")))
                    {
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#icons" aria-expanded="false" aria-controls="icons">
                                <span class="menu-title">@Localizer["Products"]</span>
                                <i class="menu-arrow"></i>
                                <i class="fa fa-tasks"></i>
                            </a>
                            <div class="collapse" id="icons">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="SearvicesApi">@Localizer["Services"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewRoseType" asp-area="Admin" asp-controller="Product">@Localizer["RoseType"] </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewRoseColor" asp-area="Admin" asp-controller="Product">@Localizer["RoseColor"] </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewFrame" asp-area="Admin" asp-controller="Product">@Localizer["Frame"]</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="ViewBackground" asp-area="Admin" asp-controller="Product">@Localizer["Background"]</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#forms" aria-expanded="false" aria-controls="forms">
                            <span class="menu-title">@Localizer["Customers"]</span>
                            <i class="menu-arrow"></i>
                            <i class="fa fa-group"></i>
                        </a>
                        <div class="collapse" id="forms">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="ViewCustomer" asp-area="Admin" asp-controller="Customer">@Localizer["ViewCustomer"] </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="Chat">@Localizer["ViewChat"] </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#charts" aria-expanded="false" aria-controls="charts">
                            <span class="menu-title">@Localizer["Booking"]</span>
                            <i class="menu-arrow"></i>
                            <i class="fa fa-calendar"></i>
                        </a>
                        <div class="collapse" id="charts">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Booking" asp-area="Admin" asp-controller="Booking">@Localizer["ViewBooking"] </a>
                                </li>
                                
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#tables" aria-expanded="false" aria-controls="tables">
                            <span class="menu-title">@Localizer["Payment"]</span>
                            <i class="menu-arrow"></i>
                            <i class="fa fa-credit-card"></i>
                        </a>
                        <div class="collapse" id="tables">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Payment" asp-area="Admin" asp-controller="Payment">@Localizer["ViewPayment"]</a>
                                </li>
                                
                            </ul>
                        </div>
                    </li>
                    
                </ul>
            </nav>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:~/partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright © 2023 . All rights reserved. Distributed by Ayloul </span>
                    </div>
                </footer>
                <!-- partial -->
                
            </div>
            <!-- main-panel ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="~/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="~/assets/js/off-canvas.js"></script>
    <script src="~/assets/js/misc.js"></script>
    <script src="~/assets/js/settings.js"></script>
    <script src="~/assets/js/todolist.js"></script>
    <script src="~/assets/js/jquery.cookie.js"></script>
    <script>
        document.getElementById("pageSearch").addEventListener("input", function () {

            let searchText = this.value.toLowerCase().trim();

            // كل النص الموجود داخل الصفحة
            let bodyText = document.body.innerText.toLowerCase();

            if (searchText === "") {
                return;
            }

            let index = bodyText.indexOf(searchText);

            if (index !== -1) {
                window.find(searchText);
            }
        });
    </script>

    <!-- endinject -->
    <!-- Custom js for this page -->
    <!-- End custom js for this page -->
    @RenderSection("Scripts", required: false)
</body>
</html>