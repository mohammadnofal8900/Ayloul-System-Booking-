 @model List<MyBookingDto>

<div class="main-panel">
    <div class="content-wrapper">

        <div class="page-header">
            <h3 class="page-title">
                My Bookings
            </h3>
        </div>


        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                You don't have any bookings yet.
            </div>
        }
        else
        {
            <div class="row">

                @foreach (var booking in Model)
                {
                    <div class="col-md-6 grid-margin stretch-card">

                        <div class="card" style="box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;">

                            <div class="card-body">

                                <div class="d-flex justify-content-between">

                                    <h4 class="card-title">
                                        Booking #@booking.BookingNumber
                                    </h4>

                                    <span>
                                        @booking.TotalPrice.ToString("0.00") JD
                                    </span>

                                </div>


                                <hr />


                                <p>
                                    <strong>Name:</strong>
                                    @booking.Name
                                </p>

                                <p>
                                    <strong>Phone:</strong>
                                    @booking.PhoneNumber
                                </p>

                                <p>
                                    <strong>Description:</strong>
                                    @booking.Description
                                </p>

                                <p>
                                    <strong>Location:</strong>
                                    @booking.LocationName
                                </p>

                                <p>
                                    <strong>Delivery Date:</strong>
                                    @booking.DeliveryDate.ToString("dd/MM/yyyy hh:mm tt")
                                </p>

                                <p>
                                    <strong>Order Date:</strong>
                                    @booking.OrderDate.ToString("dd/MM/yyyy hh:mm tt")
                                </p>


                                @if (booking.Services != null &&
                                                        booking.Services.Any())
                                {
                                    <p>
                                        <strong>Services:</strong>
                                    </p>

                                    <ul>
                                        @foreach (var service in booking.Services)
                                        {
                                            <li>
                                                @service
                                            </li>
                                        }
                                    </ul>
                                }


                                <p>
                                    <strong>Status:</strong>

                                    @if (booking.BookingStatus == 1)
                                    {
                                        <span class="badge badge-warning">
                                            Pending
                                        </span>
                                    }
                                    else if (booking.BookingStatus == 2)
                                    {
                                        <span class="badge badge-info">
                                            Accepted
                                        </span>
                                    }
                                    else if (booking.BookingStatus == 4)
                                    {
                                        <span class="badge badge-success">
                                            Completed
                                        </span>
                                    }
                                    else if (booking.BookingStatus == 5)
                                    {
                                        <span class="badge badge-danger">
                                            Cancelled
                                        </span>
                                    }
                                </p>
                                <p>
                                    
                                
                                <p>
                                    <strong>Payment:</strong>

                                    @if (booking.PaymentMethod == 0)
                                    {
                                        <span>Cash</span>
                                    }
                                    else if (booking.PaymentMethod == 1)
                                    {
                                        <span>Visa</span>
                                    }
                                    }



                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
</div>