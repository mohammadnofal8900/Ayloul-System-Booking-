<script>
    document.querySelectorAll(".booking-active").forEach(item => {

        item.addEventListener("change", function () {

            let id = this.dataset.id;
            let isActive = this.checked;

            fetch('/Admin/Booking/ChangeActiveStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: id,
                    isActive: isActive
                })
            });

        });

    });
</script>
