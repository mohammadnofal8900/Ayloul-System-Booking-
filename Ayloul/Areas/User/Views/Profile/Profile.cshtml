@model ApplicationUser

<style>

    .profile-wrapper {
        margin-top: 10px;
    }

    /* Main Profile Card */
    .profile-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
        background: #fff;
    }

    .profile-cover {
        height: 150px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
    }

    .profile-cover::after {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        right: -80px;
        top: -120px;
    }

    .profile-cover::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        left: 20%;
        bottom: -100px;
    }

    .profile-header {
        position: relative;
        padding: 0 35px 28px;
    }

    .profile-avatar {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: #fff;
        border: 6px solid #fff;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: -55px;
        position: relative;
        z-index: 2;
    }

    .profile-avatar i {
        font-size: 55px;
        color: #667eea;
    }

    .profile-user-info {
        margin-top: 15px;
    }

    .profile-user-info h3 {
        font-weight: 700;
        margin-bottom: 5px;
        color: #343a40;
    }

    .profile-user-info p {
        color: #9a9a9a;
        margin-bottom: 0;
        font-size: 14px;
    }

    .profile-edit-btn {
        border-radius: 10px;
        padding: 10px 20px;
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.25);
    }


    /* Information Card */

    .info-card {
        border: 0;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .info-card .card-body {
        padding: 30px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 5px;
    }

    .section-description {
        color: #9a9a9a;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .profile-info-item {
        display: flex;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .profile-info-item:last-child {
        border-bottom: none;
    }

    .info-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 16px;
        background: #f0f2ff;
        color: #667eea;
        flex-shrink: 0;
    }

    .info-icon i {
        font-size: 22px;
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        display: block;
        font-size: 12px;
        color: #9a9a9a;
        margin-bottom: 3px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-value {
        display: block;
        font-size: 15px;
        color: #343a40;
        font-weight: 500;
        word-break: break-word;
    }

    /* Note */

    .note-box {
        background: #f8f9ff;
        border: 1px solid #eceeff;
        border-radius: 14px;
        padding: 20px;
        color: #555;
        line-height: 1.7;
        min-height: 100px;
    }

    .empty-value {
        color: #b5b5b5;
        font-style: italic;
    }

    /* Responsive */

    @@media (max-width: 767px) {

        .profile-header {
            padding: 0 20px 25px;
        }

        .profile-edit-btn {
            margin-top: 20px;
            width: 100%;
        }

        .info-card .card-body {
            padding: 22px;
        }

        .profile-info-item {
            align-items: flex-start;
        }

    }

</style>

<div class="main-panel">

<div class="content-wrapper">

    <!-- Page Header -->

    <div class="page-header">

        <h3 class="page-title">
            My Profile
        </h3>

        <nav aria-label="breadcrumb">
        </nav>

    </div>


    <div class="row profile-wrapper">

        <div class="col-12">

            <!-- PROFILE HEADER -->

            <div class="profile-card mb-4">

                <div class="profile-cover"></div>

                <div class="profile-header">

                    <div class="d-flex flex-wrap justify-content-between align-items-end">

                        <div>

                            <div class="profile-avatar">

                                <i class="mdi mdi-account"></i>

                            </div>

                            <div class="profile-user-info">

                                <h3>
                                    @Model.FUllName
                                </h3>

                                <p>
                                    <i class="mdi mdi-email-outline mr-1"></i>
                                    @Model.Email
                                </p>

                            </div>

                        </div>


                        <div style="margin-top:20px">

                            <a asp-controller="Profile"
                               asp-action="EditProfile"
                               class="btn btn-gradient-primary profile-edit-btn">

                                <i class="mdi mdi-pencil mr-1"></i>
                                Edit Profile

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- INFORMATION -->

            <div class="info-card">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-1">

                        <i class="mdi mdi-account-details-outline"
                           style="font-size:25px; color:#667eea; margin-right:10px;">
                        </i>

                        <h4 class="section-title mb-0">
                            Personal Information
                        </h4>

                    </div>

                    <p class="section-description">
                        Your personal account information
                    </p>


                    <div class="row">

                        <!-- Full Name -->

                        <div class="col-md-6">

                            <div class="profile-info-item">

                                <div class="info-icon">

                                    <i class="mdi mdi-account-outline"></i>

                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Full Name
                                    </span>

                                    <span class="info-value">

                                        @if (!string.IsNullOrWhiteSpace(Model.FUllName))
                                        {
                                            @Model.FUllName
                                        }
                                        else
                                        {
                                            <span class="empty-value">
                                                Not provided
                                            </span>
                                        }

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Email -->

                        <div class="col-md-6">

                            <div class="profile-info-item">

                                <div class="info-icon">

                                    <i class="mdi mdi-email-outline"></i>

                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Email Address
                                    </span>

                                    <span class="info-value">

                                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                                        {
                                            @Model.Email
                                        }
                                        else
                                        {
                                            <span class="empty-value">
                                                Not provided
                                            </span>
                                        }

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Phone -->

                        <div class="col-md-6">

                            <div class="profile-info-item">

                                <div class="info-icon">

                                    <i class="mdi mdi-phone-outline"></i>

                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Mobile Phone
                                    </span>

                                    <span class="info-value">

                                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                        {
                                            @Model.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="empty-value">
                                                Not provided
                                            </span>
                                        }

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Account -->

                        <div class="col-md-6">

                            <div class="profile-info-item">

                                <div class="info-icon">

                                    <i class="mdi mdi-shield-account-outline"></i>

                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Account
                                    </span>

                                    <span class="info-value">
                                        Active Account
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- NOTE -->

                    <div class="mt-4">

                        <div class="d-flex align-items-center mb-3">

                            <div class="info-icon"
                                 style="margin-right:12px;">

                                <i class="mdi mdi-note-text-outline"></i>

                            </div>

                            <div>

                                <span class="info-label">
                                    Personal Note
                                </span>

                                <small style="color:#9a9a9a;">
                                    Additional information
                                </small>

                            </div>

                        </div>


                        <div class="note-box">

                            @if (!string.IsNullOrWhiteSpace(Model.Note))
                            {
                                @Model.Note
                            }
                            else
                            {
                                <span class="empty-value">
                                    No note has been added to your profile.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

</div>


