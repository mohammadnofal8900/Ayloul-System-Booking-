@model EditProfileViewModel

<style>

    .edit-profile-wrapper {
        margin-top: 10px;
    }

    /* Main Card */

    .edit-profile-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
    }

    /* Cover */

    .profile-cover {
        height: 145px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
    }

        .profile-cover::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            right: -60px;
            top: -130px;
        }

        .profile-cover::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
            left: 25%;
            bottom: -120px;
        }

    /* Profile Header */

    .profile-header {
        padding: 0 35px 28px;
        position: relative;
    }

    .profile-avatar {
        width: 105px;
        height: 105px;
        border-radius: 50%;
        background: #fff;
        border: 6px solid #fff;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        margin-top: -52px;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .profile-avatar i {
            font-size: 52px;
            color: #667eea;
        }

    .profile-title {
        margin-top: 14px;
    }

        .profile-title h3 {
            font-weight: 700;
            color: #343a40;
            margin-bottom: 5px;
        }

        .profile-title p {
            color: #999;
            font-size: 14px;
            margin-bottom: 0;
        }


    /* Section Card */

    .section-card {
        border: 0;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 25px rgba(0,0,0,0.05);
    }

        .section-card .card-body {
            padding: 30px;
        }

    .section-heading {
        display: flex;
        align-items: center;
        margin-bottom: 5px;
    }

    .section-heading-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #f0f2ff;
        color: #667eea;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

        .section-heading-icon i {
            font-size: 21px;
        }

    .section-heading h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #343a40;
    }

    .section-description {
        color: #999;
        font-size: 13px;
        margin-bottom: 28px;
    }


    /* Form */

    .form-group label {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 10px;
        min-height: 45px;
        border: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.10);
        }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }


    /* Input with icon */

    .input-icon-wrapper {
        position: relative;
    }

        .input-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 19px;
            z-index: 2;
        }

        .input-icon-wrapper .form-control {
            padding-left: 43px;
        }


    /* Password Box */

    .password-section {
        background: #fafaff;
        border: 1px solid #eeeeff;
        border-radius: 14px;
        padding: 22px;
    }

    .password-info {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .password-info-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #f0f2ff;
        color: #667eea;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .password-info h6 {
        margin: 0 0 3px;
        font-weight: 700;
        color: #343a40;
    }

    .password-info small {
        color: #999;
    }


    /* Buttons */

    .btn-save {
        border-radius: 10px;
        padding: 11px 24px;
        box-shadow: 0 5px 15px rgba(102,126,234,0.20);
    }

    .btn-cancel {
        border-radius: 10px;
        padding: 11px 24px;
    }


    /* Responsive */

    @@media (max-width: 767px) {

        .profile-header {
            padding: 0 20px 25px;
        }

        .section-card .card-body {
            padding: 22px;
        }
    }

</style>

<div class="main-panel">

    
    <div class="content-wrapper">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <h3 class="page-title">
                Edit Profile
            </h3>

            <nav aria-label="breadcrumb">
            </nav>

        </div>


        <div class="row edit-profile-wrapper">

            <div class="col-12">


                <!-- PROFILE HEADER -->

                <div class="edit-profile-card mb-4">

                    <div class="profile-cover"></div>

                    <div class="profile-header">

                        <div class="profile-avatar">

                            <i class="mdi mdi-account"></i>

                        </div>

                        <div class="profile-title">

                            <h3>
                                @Model.FUllName
                            </h3>

                            <p>
                                <i class="mdi mdi-email-outline mr-1"></i>
                                @Model.Email
                            </p>

                        </div>

                    </div>

                </div>



                <!-- EDIT FORM -->

                <form asp-action="EditProfile"
                      asp-controller="Profile"
                      asp-area="User"
                      method="post"
                      class="forms-sample">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- PERSONAL INFORMATION -->

                    <div class="section-card mb-4">

                        <div class="card-body">

                            <div class="section-heading">

                                <div class="section-heading-icon">

                                    <i class="mdi mdi-account-edit-outline"></i>

                                </div>

                                <h4>
                                    Personal Information
                                </h4>

                            </div>

                            <p class="section-description">
                                Update your personal information and contact details
                            </p>


                            <div class="row">

                                <!-- Full Name -->

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label asp-for="FUllName">
                                            Full Name
                                        </label>

                                        <div class="input-icon-wrapper">

                                            <i class="mdi mdi-account-outline"></i>

                                            <input asp-for="FUllName"
                                                   type="text"
                                                   class="form-control"
                                                   placeholder="Enter your full name" />

                                        </div>

                                        <span asp-validation-for="FUllName"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- Email -->

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label>
                                            Email Address
                                        </label>

                                        <div class="input-icon-wrapper">

                                            <i class="mdi mdi-email-outline"></i>

                                            <input type="email"
                                                   class="form-control"
                                                   value="@Model.Email"
                                                   readonly />

                                        </div>

                                        <small class="text-muted">
                                            Email address cannot be changed here.
                                        </small>

                                    </div>

                                </div>


                                <!-- Phone -->

                                <div class="col-md-6">

                                    <div class="form-group">

                                        <label asp-for="PhoneNumber">
                                            Mobile Phone
                                        </label>

                                        <div class="input-icon-wrapper">

                                            <i class="mdi mdi-phone-outline"></i>

                                            <input asp-for="PhoneNumber"
                                                   type="text"
                                                   class="form-control"
                                                   placeholder="Enter your mobile phone" />

                                        </div>

                                        <span asp-validation-for="PhoneNumber"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- NOTE -->

                            <div class="form-group mb-0">

                                <label asp-for="Note">
                                    Personal Note
                                </label>

                                <textarea asp-for="Note"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Write something about yourself..."></textarea>

                                <span asp-validation-for="Note"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="section-card mb-4">

                        <div class="card-body">

                            <div class="section-heading">

                                <div class="section-heading-icon">

                                    <i class="mdi mdi-lock-outline"></i>

                                </div>

                                <h4>
                                    Change Password
                                </h4>

                            </div>

                            <p class="section-description">
                                Update your password to keep your account secure
                            </p>


                            <div class="password-section">

                                <div class="password-info">

                                    <div class="password-info-icon">

                                        <i class="mdi mdi-shield-lock-outline"></i>

                                    </div>

                                    <div>

                                        <h6>
                                            Password Security
                                        </h6>

                                        <small>
                                            Enter your current password and choose a new password.
                                        </small>

                                    </div>

                                </div>


                                <div class="row">

                                    <!-- Current Password -->

                                    <div class="col-md-4">

                                        <div class="form-group">

                                            <label asp-for="CurrentPassword">
                                                Current Password
                                            </label>

                                            <div class="input-icon-wrapper">

                                                <i class="mdi mdi-lock-outline"></i>

                                                <input asp-for="CurrentPassword"
                                                       type="password"
                                                       class="form-control"
                                                       placeholder="Current password"
                                                       autocomplete="current-password" />

                                            </div>

                                            <span asp-validation-for="CurrentPassword"
                                                  class="text-danger">
                                            </span>

                                        </div>

                                    </div>


                                    <!-- New Password -->

                                    <div class="col-md-4">

                                        <div class="form-group">

                                            <label asp-for="NewPassword">
                                                New Password
                                            </label>

                                            <div class="input-icon-wrapper">

                                                <i class="mdi mdi-lock-outline"></i>

                                                <input asp-for="NewPassword"
                                                       type="password"
                                                       class="form-control"
                                                       placeholder="New password"
                                                       autocomplete="new-password" />

                                            </div>

                                            <span asp-validation-for="NewPassword"
                                                  class="text-danger">
                                            </span>

                                        </div>

                                    </div>


                                    <!-- Confirm Password -->

                                    <div class="col-md-4">

                                        <div class="form-group">

                                            <label asp-for="ConfirmPassword">
                                                Confirm Password
                                            </label>

                                            <div class="input-icon-wrapper">

                                                <i class="mdi mdi-lock-check-outline"></i>

                                                <input asp-for="ConfirmPassword"
                                                       type="password"
                                                       class="form-control"
                                                       placeholder="Confirm new password"
                                                       autocomplete="new-password" />

                                            </div>

                                            <span asp-validation-for="ConfirmPassword"
                                                  class="text-danger">
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                        

                    </div>


                    <!-- ACTION BUTTONS -->

                    <div class="section-card">

                        <div class="card-body">

                            <div class="d-flex flex-wrap justify-content-end">

                                <a asp-controller="Profile"
                                   asp-action="Profile"
                                   asp-area="User"
                                   class="btn btn-light btn-cancel mr-2">

                                    <i class="mdi mdi-close mr-1"></i>

                                    Cancel

                                </a>


                                <button type="submit"
                                        class="btn btn-gradient-primary btn-save">

                                    <i class="mdi mdi-content-save-outline mr-1"></i>

                                    Save Changes

                                </button>

                            </div>

                        </div>

                    </div>


                </form>

            </div>

        </div>

    </div>
    

</div>
